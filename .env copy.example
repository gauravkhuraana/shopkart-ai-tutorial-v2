# Copy this file to .env  (Windows: copy .env.example .env   ·   Mac/Linux: cp .env.example .env)
# Free Groq key, no credit card: https://console.groq.com/keys  ->  paste it in BOTH places marked gsk_your_key_here

# ---------- 1. The model that powers YOUR bot and agents ----------
# Option A (default): Groq's free cloud. Nothing to install.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=openai/gpt-oss-20b

# Option B: Ollama on your laptop (works offline)  ->  ollama pull qwen3:4b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:4b

# Option C: LM Studio on your laptop (start its local server first)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=qwen3-4b

# ---------- 2. The AI judge (Part 2) ----------
# The same free Groq key as above
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=gsk_your_key_here
JUDGE_MODEL=openai/gpt-oss-120b

# Backup judge: Cerebras free tier (https://cloud.cerebras.ai)
# JUDGE_BASE_URL=https://api.cerebras.ai/v1
# JUDGE_API_KEY=csk_your_key_here
# JUDGE_MODEL=gpt-oss-120b

# ---------- 3. Where the tests find the bot ----------
# Your own bot (build/step5_agent), or the hosted ShopKart bot URL from the slide if your laptop can't run it.
SHOPKART_URL=http://localhost:8000