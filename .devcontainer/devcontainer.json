{
  "name": "ShopKart AI tutorial",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  // Same one-command setup as on a laptop: creates .venv, installs the packages, creates .env.
  // Terminals then activate .venv by themselves, so every command in COMMANDS_MAC.md works unchanged.
  "postCreateCommand": "python3.12 setup_env.py --skip-check",

  // Ask for the Groq key when the Codespace is created (free key: https://console.groq.com/keys).
  // Use the SAME key for both. Secrets arrive as environment variables and win over the .env file.
  "secrets": {
    "LLM_API_KEY": {
      "description": "Your free Groq key (starts with gsk_). Powers YOUR bot. https://console.groq.com/keys"
    },
    "JUDGE_API_KEY": {
      "description": "The same free Groq key again. Powers the AI judge (Part 2)."
    }
  },

  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "ShopKart bot (open this)", "onAutoForward": "openBrowser" },
    "8080": { "label": "Scoreboard (report.html)", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    },
    "codespaces": {
      "openFiles": ["PRE_CONFERENCE.md", "COMMANDS_MAC.md"]
    }
  }
}
